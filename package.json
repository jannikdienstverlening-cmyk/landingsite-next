{
  "name": "landingsite-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "content:lint": "node scripts/content-lint.mjs",
    "content:lint:build": "node scripts/content-lint.mjs --built",
    "smoke": "node scripts/smoke-routes.mjs",
    "check": "npm run lint && npm run typecheck && npm run content:lint && npm run test && npm run build && npm run content:lint:build",
    "stripe:sync": "tsx scripts/sync-stripe-catalog.ts",
    "supabase:harden-assets": "tsx scripts/harden-customer-assets.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@supabase/supabase-js": "^2.110.7",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.17.2",
    "sharp": "^0.35.3",
    "stripe": "^22.3.2",
    "workflow": "^4.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "$sharp",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.17"
    }
  }
}
