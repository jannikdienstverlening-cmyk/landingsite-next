{
  "name": "landingsite-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "content:lint": "node scripts/content-lint.mjs",
    "content:lint:build": "node scripts/content-lint.mjs --built",
    "seo:audit": "tsx scripts/seo/audit.ts",
    "seo:report": "tsx scripts/seo/gsc-report.ts",
    "seo:links": "tsx scripts/seo/check-links.ts",
    "seo:content-lint": "node scripts/content-lint.mjs && tsx scripts/seo/content-lint.ts",
    "seo:schema": "tsx scripts/seo/schema-check.ts",
    "seo:screenshots": "tsx scripts/seo/capture-screenshots.ts",
    "seo:sitemap-check": "tsx scripts/seo/sitemap-check.ts",
    "seo:check": "npm run seo:content-lint && npm run seo:links && npm run seo:schema && npm run seo:sitemap-check && npm run seo:audit",
    "smoke": "node scripts/smoke-routes.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm run seo:check && npm run test && npm run build && npm run content:lint:build",
    "stripe:sync": "tsx scripts/sync-stripe-catalog.ts",
    "stripe:validate": "tsx scripts/validate-stripe-catalog.ts",
    "supabase:harden-assets": "tsx scripts/harden-customer-assets.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@supabase/supabase-js": "^2.110.7",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.17.2",
    "sharp": "^0.35.3",
    "stripe": "^22.3.2",
    "workflow": "^4.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "$sharp",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "js-yaml": "4.3.1",
    "nanoid": "5.1.16",
    "undici": "7.29.0"
  }
}
